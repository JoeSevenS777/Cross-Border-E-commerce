# -*- coding: utf-8 -*-
"""
1688 Order → Package Arrival Management Script

Workflow implemented according to confirmed logic:

- Each row represents ONE (订单编号, 运单号) relationship
- No missing 订单编号 or 运单号
- Supports:
  1) Sync clean workbook from latest 1688 export
  2) Paste arrival text to update 到达情况 / 备注

Key rules:
- Duplicate 订单编号 highlighted (one order, multiple packages)
- Duplicate 运单号 highlighted (one package, multiple orders)
- Column headers show unique totals: 订单编号（N）, 运单号（M）
- Parsed export files are moved to ./parsed files/

NOTE:
- This script assumes all orders in export already have 运单号
- 到达情况 / 备注 are preserved across syncs
"""

import os
import re
import unicodedata
import tempfile
import shutil
import sys
import traceback
from collections import Counter, defaultdict
from openpyxl import load_workbook, Workbook
from openpyxl.styles import PatternFill

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
PARSED_DIR = os.path.join(BASE_DIR, "parsed files")
CLEAN_FILE = "Order_Package_arrival_Confirmation.xlsx"

RED_FILL = PatternFill(start_color="FFB6C1", end_color="FFB6C1", fill_type="solid")

REQUIRED_COLUMNS = [
    "订单编号",
    "卖家公司名",
    "订单状态",
    "订单创建时间",
    "订单付款时间",
    "物流公司",
    "运单号",
]

# -------------------------------------------------------------------
# Utility functions
# -------------------------------------------------------------------

def find_all_exports():
    """Find ALL unparsed 1688 export workbooks in BASE_DIR.

    Rules:
    - Only look in BASE_DIR (not in ./parsed files)
    - Ignore the clean workbook and Excel temp files (~$*)

    Returns: list of filenames (List[str])
    Raises FileNotFoundError if none found.
    """
    exports = []
    for f in os.listdir(BASE_DIR):
        if not f.lower().endswith(".xlsx"):
            continue
        if f == CLEAN_FILE:
            continue
        if f.startswith("~$"):
            continue
        full = os.path.join(BASE_DIR, f)
        if os.path.isfile(full):
            exports.append(f)

    if not exports:
        raise FileNotFoundError(
            "No new export workbook found in the base folder.\n"
            "Action: Export the on-the-way list from 1688 and place the .xlsx file in the same folder as this script.\n"
            "Note: Parsed exports are moved into ./parsed files/, and are not considered new exports."
        )

    return exports


def normalize_header(header):
    """Normalize headers so columns can be found even after we add counts like 订单编号（26）."""
    s = "" if header is None else str(header).strip()
    if not s:
        return s
    # Convert full-width parentheses to half-width for easier parsing
    s = s.replace("（", "(").replace("）", ")")
    # If header contains a trailing count like "订单编号(26)", strip it
    if "(" in s and s.endswith(")"):
        base = s.split("(", 1)[0].strip()
        inside = s[len(base):].strip()  # e.g. "(26)"
        num = inside[1:-1] if inside.startswith("(") and inside.endswith(")") else ""
        if num.isdigit() and base:
            return base
    return s


def normalize_tracking(v) -> str:
    """Normalize without converting text tracking numbers through float."""
    if v is None:
        return ""
    if isinstance(v, float) and v.is_integer():
        v = int(v)
    value = re.sub(r"\s+", "", unicodedata.normalize("NFKC", str(v))).upper()
    if re.fullmatch(r"[0-9]+\.0", value):
        value = value[:-2]
    return value


# -------------------------------------------------------------------
# Step 1: Parse messy 1688 export into (订单编号, 运单号) rows
# -------------------------------------------------------------------

def count_total_orders_in_exports(filepaths) -> int:
    """Count total number of DISTINCT order IDs (订单编号) across ALL 1688 exports."""
    orders = set()
    for filepath in filepaths:
        wb = load_workbook(resolve_path(filepath), data_only=True)
        ws = wb.active

        header_row = [normalize_header(c.value) for c in ws[1]]
        try:
            order_col_idx = header_row.index("订单编号")
        except ValueError:
            raise ValueError(f"Missing required column 订单编号 in export: {filepath}")

        for row in ws.iter_rows(min_row=2, values_only=True):
            v = row[order_col_idx]
            if v is None:
                continue
            s = str(v).strip()
            if s:
                orders.add(s)
    return len(orders)


def resolve_path(p: str) -> str:
    return p if os.path.isabs(p) else os.path.join(BASE_DIR, p)


def parse_export(filepath):
    filepath = resolve_path(filepath)
    wb = load_workbook(resolve_path(filepath), data_only=True)
    ws = wb.active

    header_row = [normalize_header(c.value) for c in ws[1]]
    col_index = {}
    for idx, name in enumerate(header_row):
        if name in REQUIRED_COLUMNS:
            col_index[name] = idx

    missing = set(REQUIRED_COLUMNS) - set(col_index)
    if missing:
        raise ValueError(f"Missing required columns: {missing}")

    raw_rows = []
    for row in ws.iter_rows(min_row=2, values_only=True):
        record = {k: row[col_index[k]] for k in REQUIRED_COLUMNS}
        if record["订单编号"] and record["运单号"]:
            raw_rows.append(record)

    # group by (订单编号, 运单号)
    grouped = defaultdict(list)
    for r in raw_rows:
        key = (str(r["订单编号"]), normalize_tracking(r["运单号"]))
        grouped[key].append(r)

    clean_rows = []
    for (order_id, tracking), rows in grouped.items():
        row_out = {
            "订单编号": order_id,
            "运单号": tracking,
        }
        # logistics company: most common
        lc = Counter(r["物流公司"] for r in rows if r["物流公司"]).most_common(1)
        row_out["物流公司"] = lc[0][0] if lc else ""

        # order-level fields
        for field in ["卖家公司名", "订单状态", "订单创建时间", "订单付款时间"]:
            cnt = Counter(r[field] for r in rows if r[field]).most_common(1)
            row_out[field] = cnt[0][0] if cnt else ""

        clean_rows.append(row_out)

    return clean_rows


# -------------------------------------------------------------------
# Step 2: Load existing clean workbook (if exists)
# -------------------------------------------------------------------

def load_existing():
    """Load existing clean workbook and preserve 到达情况 / 备注 by (订单编号, 运单号).

    Returns:
      preserved: dict[(order_id, tracking)] -> {"到达情况": str, "备注": str}
      headers: normalized header list
    """
    if not os.path.exists(CLEAN_FILE):
        return {}, []

    wb = load_workbook(CLEAN_FILE)
    ws = wb.active

    headers = [normalize_header(c.value) for c in ws[1]]
    idx = {h: i for i, h in enumerate(headers)}

    # Required columns in clean file
    if "订单编号" not in idx or "运单号" not in idx:
        raise ValueError(f"Clean workbook missing required columns: 订单编号 / 运单号. Found: {headers}")

    status_i = idx.get("到达情况")
    note_i = idx.get("备注")

    preserved = {}
    for row in ws.iter_rows(min_row=2, values_only=True):
        order_val = row[idx["订单编号"]]
        tracking_val = row[idx["运单号"]]
        if order_val is None or tracking_val is None:
            continue

        order_id = str(order_val).strip()
        tracking = normalize_tracking(tracking_val)
        if not order_id or not tracking:
            continue

        preserved[(order_id, tracking)] = {
            "到达情况": "" if status_i is None else (row[status_i] if row[status_i] is not None else ""),
            "备注": "" if note_i is None else (row[note_i] if row[note_i] is not None else ""),
        }
    return preserved, headers


# -------------------------------------------------------------------
# Step 3: Write clean workbook
# -------------------------------------------------------------------

def auto_adjust_column_width(ws):
    """Auto-adjust column widths based on max content length."""
    for col_cells in ws.columns:
        max_len = 0
        col_letter = col_cells[0].column_letter
        for cell in col_cells:
            try:
                if cell.value is not None:
                    max_len = max(max_len, len(str(cell.value)))
            except Exception:
                pass
        # Add padding; cap to a reasonable max width
        ws.column_dimensions[col_letter].width = min(max_len + 2, 60)


# -------------------------------------------------------------------
# Step 3: Write clean workbook
# -------------------------------------------------------------------

def write_clean(rows, preserved):
    wb = Workbook()
    ws = wb.active

    headers = REQUIRED_COLUMNS + ["到达情况", "备注"]
    ws.append(headers)

    for r in rows:
        key = (r["订单编号"], r["运单号"])
        extra = preserved.get(key, {"到达情况": "", "备注": ""})
        ws.append([
            r.get("订单编号"),
            r.get("卖家公司名"),
            r.get("订单状态"),
            r.get("订单创建时间"),
            r.get("订单付款时间"),
            r.get("物流公司"),
            r.get("运单号"),
            extra.get("到达情况"),
            extra.get("备注"),
        ])

    # highlight duplicates
    order_ids = [ws.cell(row=i, column=1).value for i in range(2, ws.max_row + 1)]
    trackings = [ws.cell(row=i, column=7).value for i in range(2, ws.max_row + 1)]

    order_cnt = Counter(order_ids)
    track_cnt = Counter(trackings)

    for i in range(2, ws.max_row + 1):
        if order_cnt[ws.cell(row=i, column=1).value] > 1:
            ws.cell(row=i, column=1).fill = RED_FILL
        if track_cnt[ws.cell(row=i, column=7).value] > 1:
            ws.cell(row=i, column=7).fill = RED_FILL

    # update header counts (unique totals)
    ws["A1"].value = f"订单编号（{len(order_cnt)}）"
    ws["G1"].value = f"运单号（{len(track_cnt)}）"

    # auto-adjust column widths
    auto_adjust_column_width(ws)

    try:
        wb.save(CLEAN_FILE)
    except PermissionError:
        print(f"ERROR: '{CLEAN_FILE}' is currently open in Excel.")
        print("Please close the workbook in Excel and run the script again.")
        raise SystemExit(1)


# -------------------------------------------------------------------
# Step 4: Apply arrival text updates
# -------------------------------------------------------------------

def read_arrival_text():
    """Blank lines are content; only END on its own line finishes input."""
    print("Paste arrival text. Type END on a separate line to save automatically:")
    lines = []
    while True:
        try:
            line = input()
        except EOFError:
            break
        if line.strip() == "END":
            break
        lines.append(line)
    return "\n".join(lines)


TIMESTAMP = re.compile(r"(?:20[0-9]{2}[年/.-][0-9]{1,2}[月/.-][0-9]{1,2}|[0-9]{1,2}:[0-9]{2})")
IMAGE = re.compile(r"\[图片\]|【图片】|微信图片|\.(?:dat|jpg|jpeg|png|gif)\b", re.I)
OTHER_TRACKING = re.compile(r"(?<![A-Z0-9])[A-Z]{0,4}[0-9]{10,}(?![A-Z0-9])", re.I)
CARRIER = re.compile(r"承运公司|运单号|^(?:中通|圆通|申通|韵达|极兔|安能|信丰|顺丰|邮政|京东)(?:快递|速递|物流)?(?:\([A-Z]+\))?$", re.I)


def find_pending_arrivals(text, pending):
    """Whitelist matching; surrounding message structure only determines remarks."""
    lines = [unicodedata.normalize("NFKC", line).strip() for line in text.splitlines()]
    meaningful = [i for i, line in enumerate(lines) if line]
    senders = {lines[meaningful[n-1]] for n, i in enumerate(meaningful)
               if n and TIMESTAMP.match(lines[i])}
    senders.add("乐购易")
    patterns = {key: re.compile(r"(?<![A-Z0-9])" +
                r"[ \t]*".join(re.escape(c) for c in key) +
                r"(?![A-Z0-9])", re.I) for key in pending}
    found = {}

    def noise(line):
        return (line in senders or TIMESTAMP.match(line) or IMAGE.search(line)
                or CARRIER.search(line) or OTHER_TRACKING.search(line)
                or any(p.search(line) for p in patterns.values()))

    for i, line in enumerate(lines):
        if IMAGE.search(line) or TIMESTAMP.match(line) or line in senders:
            continue
        hits = sorted((m.start(), m.end(), key) for key, p in patterns.items()
                      for m in p.finditer(line))
        for start, end, key in hits:
            notes = found.setdefault(key, [])
            # Stop at the next tracking token, including numbers outside the whitelist.
            tail = line[end:]
            next_token = OTHER_TRACKING.search(tail)
            next_hit = min((h[0]-end for h in hits if h[0] >= end), default=len(tail))
            cutoff = min(next_hit, next_token.start() if next_token else len(tail))
            note = tail[:cutoff].strip(" ,，;；:：|、")
            if not note and cutoff == len(tail):
                for following in lines[i+1:]:
                    if not following:
                        continue
                    if not noise(following):
                        note = following
                    break
            if note and not noise(note) and note not in notes:
                notes.append(note)
    return found


def apply_arrival_text(text: str):
    """Save pending arrivals automatically, then print the actual saved changes.

    Existing nonblank statuses are untouched. Returns (updated row count,
    pending tracking numbers absent from the pasted text).
    """
    path = resolve_path(CLEAN_FILE)
    if not os.path.exists(path):
        raise FileNotFoundError(f"{path} not found. Run sync mode first.")
    wb = load_workbook(path)
    try:
        ws = wb.active
        idx = {normalize_header(c.value): c.column for c in ws[1]}
        missing = [h for h in ("运单号", "到达情况", "备注") if h not in idx]
        if missing:
            raise ValueError(f"Clean workbook missing columns: {missing}")
        pending = defaultdict(list)
        for row in range(2, ws.max_row + 1):
            status = ws.cell(row, idx["到达情况"]).value
            if status is not None and str(status).strip():
                continue
            key = normalize_tracking(ws.cell(row, idx["运单号"]).value)
            if key:
                pending[key].append(row)
        found = find_pending_arrivals(text, pending)
        changes = []
        for key, notes in found.items():
            for row in pending[key]:
                cell = ws.cell(row, idx["备注"])
                existing = "" if cell.value is None else str(cell.value)
                merged = existing
                for note in notes:
                    if note not in [part.strip() for part in merged.split(" | ")]:
                        merged = merged + " | " + note if merged.strip() else note
                if merged != existing:
                    cell.value = merged
                    cell.data_type = "s"
                ws.cell(row, idx["到达情况"]).value = "已到达"
                changes.append((row, key, merged))
        if changes:
            # Keep the original intact if writing fails (for example Excel has it open).
            fd, temp_path = tempfile.mkstemp(suffix=".xlsx", dir=os.path.dirname(path))
            os.close(fd)
            try:
                wb.save(temp_path)
                os.replace(temp_path, path)
            finally:
                if os.path.exists(temp_path):
                    os.remove(temp_path)
        unmatched = [key for key in pending if key not in found]
        print("\nArrival update record (saved):" if changes else "\nNo changes needed.")
        print(f"  Pending rows checked: {sum(map(len, pending.values()))}")
        print(f"  Pending tracking numbers checked: {len(pending)}")
        print(f"  Tracking numbers found: {len(found)}")
        print(f"  Rows updated: {len(changes)}")
        for row, key, note in changes:
            print(f"  Row {row} | {key} | 已到达 | 备注: {note or '(blank)'}")
        print(f"  Still not found: {len(unmatched)}")
        for key in unmatched:
            print(f"  - {key}")
        return len(changes), unmatched
    finally:
        wb.close()


# -------------------------------------------------------------------
# Step 5: Move parsed export
# -------------------------------------------------------------------

def archive_export(filename):
    os.makedirs(PARSED_DIR, exist_ok=True)
    shutil.move(os.path.join(BASE_DIR, filename),
                os.path.join(PARSED_DIR, filename))


# -------------------------------------------------------------------
# Entry point
# -------------------------------------------------------------------

def open_clean_workbook():
    """Open the clean workbook with the default associated app (Excel on Windows)."""
    path = os.path.join(BASE_DIR, CLEAN_FILE)
    if not os.path.exists(path):
        print(f"WARNING: Cannot open workbook because it does not exist: {path}")
        return
    try:
        # Windows: opens in Excel (or default .xlsx handler)
        os.startfile(path)  # type: ignore[attr-defined]
    except Exception as e:
        print(f"WARNING: Failed to open workbook automatically: {e}")
        print(f"Please open manually: {path}")


def main():
    print("Choose mode:")
    print("1 - Sync from ALL new 1688 exports")
    print("2 - Paste arrival info")
    choice = input("Enter 1 or 2: ").strip()

    try:
        if choice == "1":
            exports = find_all_exports()
        
            total_orders = count_total_orders_in_exports(exports)
            print(f"发现 {len(exports)} 个1688导出文件")
            print(f"待收货订单总有 {total_orders} ，")
            ans = input("确认请按Y/y同步，否则按其他任意键退出: ").strip().lower()
            if ans != "y":
                print("Cancelled. No changes made.")
                return 0
        
            all_rows = []
            for export in exports:
                all_rows.extend(parse_export(export))
        
            preserved, _ = load_existing()
            write_clean(all_rows, preserved)
        
            for export in exports:
                archive_export(export)
        
            print("Sync completed successfully.")
            open_clean_workbook()
            return 0

        elif choice == "2":
            text = read_arrival_text()
            apply_arrival_text(text)

            # Auto-open workbook on success
            open_clean_workbook()
            return 0

        else:
            print("Invalid choice.")
            return 1

    except SystemExit as e:
        # keep existing behavior where write_clean/apply_arrival_text call SystemExit
        return int(e.code) if isinstance(e.code, int) else 1
    except Exception as e:
        print("ERROR: An unexpected error occurred:")
        print(str(e))
        # Print traceback for debugging
        traceback.print_exc()
        return 1


if __name__ == "__main__":
    sys.exit(main())
